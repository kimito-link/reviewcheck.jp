{
  "name": "reviewcheck-site",
  "version": "0.1.0",
  "private": true,
  "description": "口コミチェック.jp / Review Check Site - 店舗名・GoogleマップURLから公開されている星と口コミ数を表示し、既存の相談メニューへ進めるサービス",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --filter @reviewcheck/web dev",
    "build": "pnpm --filter @reviewcheck/web build",
    "start": "pnpm --filter @reviewcheck/web start",
    "lint": "pnpm --filter @reviewcheck/web lint",
    "typecheck": "pnpm -r typecheck",
    "icons": "node scripts/generate-icons.mjs",
    "ext:zip": "pnpm --filter @reviewcheck/chrome-extension zip",
    "test": "node --experimental-strip-types --import ./packages/core/test-loader.mjs --test \"packages/{core,monitor}/src/**/*.test.ts\" && pnpm --filter @reviewcheck/web test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "sharp": "^0.34.0",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
