{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs apps/web/ packages/ package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.reviewcheck.jp" }],
      "destination": "https://reviewcheck.jp/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/monitor/monthly-report",
      "schedule": "0 0 1 * *"
    }
  ]
}
