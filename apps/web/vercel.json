{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.reviewcheck.jp" }],
      "destination": "https://reviewcheck.jp/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/monitor/monthly-report",
      "schedule": "0 0 1 * *"
    }
  ]
}
