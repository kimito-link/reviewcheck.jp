{
  "manifest_version": 3,
  "name": "口コミチェック.jp｜Google口コミチェッカー",
  "short_name": "口コミチェック",
  "version": "0.1.0",
  "description": "今開いているページのGoogle口コミを簡易チェックし、スコアと要点を表示します。前回の点検は端末内だけに残します。",
  "default_locale": "ja",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "この店舗を口コミ診断",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://reviewcheck.jp/*"]
}
